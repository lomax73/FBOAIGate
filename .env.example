# Copiare in .env e valorizzare. Non committare mai .env.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite in sviluppo (default, nessuna configurazione necessaria).
# Per usare Postgres in produzione, impostare DB_ENGINE=postgresql e i DB_*.
DB_ENGINE=sqlite
DB_NAME=fboaigate
DB_USER=fboaigate
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Pianificazione subnet VPN WireGuard hub-and-spoke di FBOAIGate (Fase 0 / Fase 1).
# Hub dedicato, isolato da quello di MKRemote (10.10.0.0/24).
VPN_SUBNET_CIDR=10.20.0.0/24
VPN_HUB_IP=10.20.0.1
VPN_TARGET_IP_RANGE_START=10.20.0.2

# Chiave privata SSH di servizio usata dalla console per collegarsi ai Target
# (Fase 2). In produzione (sul VPS) va generata una chiave dedicata dell'hub,
# distinta dalle chiavi personali degli amministratori.
CONSOLE_SSH_PRIVATE_KEY_PATH=

# Token per la API interna di gestione utenti (accounts/), usata dal Portale
# FBO per creare/modificare/eliminare account su questa app (Fase 3). Stesso
# pattern di MKRemote. Generare con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# Redis per il layer di Channels (WebSocket) in produzione. Se vuoto, si usa
# un layer in-memory (va bene solo per un singolo processo, come in sviluppo).
CHANNELS_REDIS_URL=
